<?xml version="1.0"?>
<odoo>
    <data>
        <record id="filter_management_form_view_id" model="ir.ui.view">
            <field name="name">Filter Management Wags</field>
            <field name="model">filter.management.wags</field>
            <field name="arch" type="xml">
                <form string="Filter Management Wags">
                    <sheet>
                        <group name="group_top">
                            <group name="group_left">
                                <field name="model_id" options="{'no_create':True}" string="Model" required="1"/>
                                <field name="hide_filter_fields" widget="many2many_tags" string="Hide Filter Fields"
                                       domain="[('model_id','=',model_id)]"/>
                            </group>
                            <group name="group_right">
                                <field name="create_date" readonly="1" force_save="1"/>
                                <field name="hide_group_by_fields" widget="many2many_tags" string="Hide Group By Fields"
                                       domain="[('model_id','=',model_id)]"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="filter_management_list">
            <field name="name">Filter Management Wags</field>
            <field name="model">filter.management.wags</field>
            <field name="arch" type="xml">
                <list>
                    <field name="model_id"/>
                    <field name="hide_filter_fields" widget="many2many_tags"/>
                    <field name="hide_group_by_fields" widget="many2many_tags"/>
                </list>
            </field>
        </record>


        <record id="filter_management_wags_action" model="ir.actions.act_window">
            <field name="name">Filter Management</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">filter.management.wags</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
        </record>

        <menuitem name="Filter Management" id="filter_management_menu" sequence="60"
                  action="filter_management_wags_action" web_icon="filter_management,static/description/icon.png"
                  groups="base.group_user"/>


    </data>
</odoo>